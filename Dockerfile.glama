# Glama-specific Dockerfile for Haldir's MCP server.
#
# Glama's introspection pipeline expects the container to start an MCP
# server that responds to JSON-RPC on stdin/stdout. Production Haldir
# runs the REST API (see ./Dockerfile); this image runs the stdio MCP
# server instead, which is what Smithery and Glama actually probe.
#
# Sterling: during the Glama "Add Server" flow, point the Dockerfile
# upload at this file (or paste its contents verbatim).

# 3.12, matching ./Dockerfile and the CI matrix. This said 3.14, which is
# neither what CI tests nor what the production image runs.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# HALDIR_API_KEY is supplied by Glama per the smithery.yaml config schema.
#
# `haldir_mcp_server`, not `mcp_server`. There has never been a module by the
# latter name — pyproject records that one was removed — so this container
# exited on `ModuleNotFoundError` every time it started. smithery.yaml already
# named the right one; only this file still pointed at the deleted module.
CMD ["python", "-m", "haldir_mcp_server"]
